 using namespace Crypto;
 
+namespace {
+
+void secure_erase_bytes( void *buffer, size_t length )
+{
+  volatile unsigned char *cursor =
+    static_cast<volatile unsigned char *>( buffer );
+  while ( length-- != 0 ) {
+    *cursor++ = 0;
+  }
+}
+
+class ScopedErase {
+private:
+  void *buffer;
+  size_t length;
+  bool active;
+
+public:
+  ScopedErase( void *s_buffer, size_t s_length )
+    : buffer( s_buffer ), length( s_length ), active( true ) {}
+  ~ScopedErase() { if ( active ) { secure_erase_bytes( buffer, length ); } }
+  void release( void ) { active = false; }
+  ScopedErase( const ScopedErase & ) = delete;
+  ScopedErase &operator=( const ScopedErase & ) = delete;
+};
+
+} /* anonymous namespace */
