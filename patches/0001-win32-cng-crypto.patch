+/*-------------------*/
+#elif USE_BCRYPT_AES
+/*-------------------*/
+
+#include "platform/win32_crypto.h"
+#include <memory>
+
+namespace ocb_aes {
+
+struct KEY {
+    std::unique_ptr<mosh::win32::Aes128Ecb> implementation;
+};
+
+static KEY *KEY_new() { return new KEY; }
+
+static void KEY_delete(KEY *key) { delete key; }
+
+static void set_encrypt_key(const unsigned char *user_key, int bits, KEY *key)
+{
+    fatal_assert(bits == 128);
+    key->implementation =
+        std::make_unique<mosh::win32::Aes128Ecb>(user_key);
+}
+
+static void set_decrypt_key(const unsigned char *user_key, int bits, KEY *key)
+{
+    fatal_assert(bits == 128);
+    key->implementation =
+        std::make_unique<mosh::win32::Aes128Ecb>(user_key);
+}
+
+static void encrypt(const unsigned char *source, unsigned char *destination,
+                    KEY *key)
+{
+    fatal_assert(key != NULL && key->implementation != NULL);
+    key->implementation->encrypt_blocks(source, destination, 1);
+}
+
+#if 0
+static void decrypt(const unsigned char *source, unsigned char *destination,
+                    KEY *key)
+{
+    fatal_assert(key != NULL && key->implementation != NULL);
+    key->implementation->decrypt_blocks(source, destination, 1);
+}
+#endif
+
+static void ecb_encrypt_blks(block *blocks, unsigned count, KEY *key)
+{
+    fatal_assert(key != NULL && key->implementation != NULL);
+    key->implementation->encrypt_blocks(blocks, blocks, count);
+}
+
+static void ecb_decrypt_blks(block *blocks, unsigned count, KEY *key)
+{
+    fatal_assert(key != NULL && key->implementation != NULL);
+    key->implementation->decrypt_blocks(blocks, blocks, count);
+}
+
+}  // namespace ocb_aes
+
+#define BPI 4  /* Number of blocks in buffer per ECB call */
+
 /*-------------------*/
 #elif USE_APPLE_COMMON_CRYPTO_AES
 /*-------------------*/
